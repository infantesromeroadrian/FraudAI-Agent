# =============================================================================
# FraudAI Agent -- local configuration. NAMES AND PLACEHOLDERS ONLY.
# Copy to .env and fill in YOUR values; .env is git-ignored, never leaves your machine, and is
# the ONLY place secrets live (no exported variables, no extra token files, no argv).
# =============================================================================

# --- LLM (D2: your own Ollama daemon, reached through its OpenAI-compatible /v1) ---
# LLM_PROVIDER: ollama | openai | groq | anthropic  (invalid values fail at startup)
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:120b-cloud
# Host daemon as seen from Docker. From a process on the host use http://localhost:11434.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_KEEP_ALIVE=5m
# Only for LLM_PROVIDER=openai / groq / anthropic respectively (leave empty otherwise):
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Login (F5c). The server decides identity; the hash is NOT the password. ---
AUTH_USERNAME=<your-username>
# Generate with:  uv run python -m fraudai.api.auth   (prompts without echo)
AUTH_PASSWORD_HASH=<output of the command above>
AUTH_TENANT_ID=default
AUTH_TIER=enterprise
AUTH_IS_ADMIN=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=60

# --- Application ---
ENVIRONMENT=production
# At least 32 random characters. Generate yours: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random-32+-characters>
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=60
DATABASE_PATH=/app/data/fraudai.db
# BUILD_SHA is baked into the image by scripts/deploy.sh. Do NOT set it here; leave it
# empty when you run the API directly on the host.

# --- Qdrant (host-run API; the Compose API gets these from the compose file) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Sandbox (ADR-007 / D4): the Compose API always runs with SANDBOX_MODE=disabled ---
# SANDBOX_MODE=docker only for an API run on a Docker host; never mount docker.sock in Compose.
SANDBOX_MODE=docker

# --- Local ports (loopback only). Change them if another project already uses one. ---
FRAUDAI_PORT=8000
FRONTEND_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# --- Monitoring (Compose) ---
# REQUIRED: Compose refuses to start without a non-empty Grafana admin password.
GRAFANA_PASSWORD=<choose-a-password>
# REQUIRED: stable (non-expiring) credential Prometheus uses to scrape /api/v1/admin/metrics;
# the API accepts it on that route only. Random, at least 32 characters. Generate one and
# paste it here, for example:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Compose passes this variable to the API and to Prometheus (whose entrypoint writes a private
# in-memory file at start); no token file is kept anywhere else.
METRICS_SCRAPE_TOKEN=<random-32+-characters>

# --- Smoke test (scripts/smoke-test.sh reads these from THIS file; nothing to export) ---
# The login password in clear (the server only knows AUTH_PASSWORD_HASH). The user name is
# AUTH_USERNAME above unless you set FRAUDAI_SMOKE_USERNAME.
FRAUDAI_SMOKE_PASSWORD=<the-password-whose-hash-is-above>
# FRAUDAI_SMOKE_USERNAME=
